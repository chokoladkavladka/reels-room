# Скопируй в .env для локального запуска (Render/Railway — задать в панели Environment)

# Токен Apify (Settings → Integrations → API tokens). Без него сайт работает
# в демо-режиме: данные генерируются стабильно по ссылке, чтобы всё выглядело
# и работало правдоподобно даже без подключённого API.
APIFY_TOKEN=

# Актор Apify для скрапинга Reels (можно заменить на любой другой актор
# Instagram-скрапера — просто поправь имя, поля парсятся с фолбэками)
APIFY_ACTOR=apify~instagram-reel-scraper

# Секрет для подписи cookie-сессии — задай свою случайную строку в проде
SESSION_SECRET=change-me

PORT=3000
